# Por defecto usa SQLite (cero configuracion). Para Postgres:
# DATABASE_URL=postgresql://triage_user:triage_password@localhost:5432/triage_db
DATABASE_URL=sqlite:///./triage.db

ALLOWED_ORIGINS=http://localhost:3000

# Minutos de inactividad tras los cuales expira una sesion del chatbot
CHAT_SESSION_TTL_MINUTES=120

# Clave para firmar las sesiones (JWT) del personal. Obligatoria en produccion;
# si falta se genera una aleatoria y las sesiones se pierden al reiniciar.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Duracion de la sesion del personal, en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Contrasena que init_db.py asigna a las cuentas de ejemplo (DOC001..DOC004)
DEMO_STAFF_PASSWORD=triage-demo
