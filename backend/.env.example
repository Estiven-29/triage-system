# Por defecto usa SQLite (cero configuracion). Para Postgres:
# DATABASE_URL=postgresql://triage_user:triage_password@localhost:5432/triage_db
DATABASE_URL=sqlite:///./triage.db

ALLOWED_ORIGINS=http://localhost:3000

# Minutos de inactividad tras los cuales expira una sesion del chatbot
CHAT_SESSION_TTL_MINUTES=120
